FFFFF;strokeColor=#D8DCE4;shadow=1;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="366" width="340" height="120" as="geometry"/></mxCell><mxCell id="n18" value="pub_versao" style="rounded=1;arcSize=16;fillColor=#66BB6A;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;html=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="366" width="340" height="34" as="geometry"/></mxCell><mxCell id="n19" value="&lt;div style=&quot;line-height:1.9;&quot;&gt;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;versao  PK&lt;br/&gt;gerado_em&lt;br/&gt;linhas · checksum&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76" y="410" width="308" height="66" as="geometry"/></mxCell><mxCell id="n20" value="" style="rounded=1;arcSize=12;fillColor=#EEF3FF;strokeColor=#0A4AAD;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="440" y="366" width="700" height="160" as="geometry"/></mxCell><mxCell id="n21" value="&lt;div style=&quot;line-height:1.6;&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Por que pub_serie é o formato longo&lt;/b&gt;&lt;br/&gt;Um indicador novo = &lt;b&gt;uma linha&lt;/b&gt; em &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;pub_indicador&lt;/span&gt; + o cálculo no gold. &lt;b&gt;Sem tocar em back-end nem em front-end.&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;É o que entrega os filtros por período e setor (funcionalidade 4) com um único endpoint — e o que evita a &amp;#8220;mudança brusca de estrutura&amp;#8221; que o professor proíbe depois do Milestone 3.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="460" y="380" width="660" height="132" as="geometry"/></mxCell><mxCell id="n22" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Contrato da API&lt;/b&gt; &amp;#183; congelado no Milestone 3, o que desbloqueia front, back e dados em paralelo a partir do Milestone 4&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="556" width="1480" height="30" as="geometry"/></mxCell><mxCell id="n23" value="" style="ellipse;fillColor=#0E9F6E;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="44" y="605" width="9" height="9" as="geometry"/></mxCell><mxCell id="n24" value="GET" style="rounded=1;arcSize=30;fillColor=#0E9F6E;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;html=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="596" width="56" height="26" as="geometry"/></mxCell><mxCell id="n25" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/api/v1/indicadores&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="128" y="596" width="570" height="26" as="geometry"/></mxCell><mxCell id="n26" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;catálogo de indicadores&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#5A6470;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="712" y="596" width="400" height="26" as="geometry"/></mxCell><mxCell id="n27" value="" style="ellipse;fillColor=#0E9F6E;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="44" y="639" width="9" height="9" as="geometry"/></mxCell><mxCell id="n28" value="GET" style="rounded=1;arcSize=30;fillColor=#0E9F6E;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;html=1;verticalAlign=middle;align=center;" vertex="1" pare