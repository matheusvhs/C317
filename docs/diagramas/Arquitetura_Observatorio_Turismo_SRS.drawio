resto do dia; cold start de 10–30 s; Apps não pode ser público.&lt;br/&gt;&lt;b&gt;Airflow + Unity Catalog OSS&lt;/b&gt; — scheduler, webserver e catálogo no ar 24/7 para ~8 tarefas de 30 s.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="958" y="420" width="604" height="88" as="geometry"/></mxCell><mxCell id="n98" value="" style="rounded=1;arcSize=14;fillColor=#E8F5E9;strokeColor=#66BB6A;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="526" width="640" height="48" as="geometry"/></mxCell><mxCell id="n99" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;&lt;b&gt;Stack 100% Apache/MIT&lt;/b&gt; — sem custo recorrente e sem impedimento de licença para a Prefeitura operar, auditar e evoluir.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="958" y="534" width="604" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pag1" name="Fluxo de publicação"><mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="" style="rounded=1;arcSize=8;fillColor=#0A4AAD;gradientColor=#6C5CE0;gradientDirection=east;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="760" height="76" as="geometry"/></mxCell><mxCell id="n2" value="" style="rounded=1;arcSize=8;fillColor=#6C5CE0;gradientColor=#C750D6;gradientDirection=east;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="30" width="760" height="76" as="geometry"/></mxCell><mxCell id="n3" value="" style="fillColor=#6C5CE0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="790" y="30" width="