los estabelecimentos&lt;/b&gt;&lt;br/&gt;Hotéis e pousadas enviam a ocupação por formulário com token, sem login &amp;#8594; &lt;b&gt;app.submissao&lt;/b&gt; &amp;#8594; fila de validação da SMCELT &amp;#8594; o que for aprovado entra no próximo ciclo de publicação. &lt;b&gt;Nunca publica direto.&lt;/b&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#1F2733;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="812" width="1294" height="68" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pag2" name="Camada de publicação e API"><mxGraphModel dx="1422" dy="798" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="" style="rounded=1;arcSize=8;fillColor=#0A4AAD;gradientColor=#6C5CE0;gradientDirection=east;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="700" height="76" as="geometry"/></mxCell><mxCell id="n2" value="" style="rounded=1;arcSize=8;fillColor=#6C5CE0;gradientColor=#C750D6;gradientDirection=east;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="740" y="30" width="700" height="76" as="geometry"/></mxCell><mxCell id="n3" value="" style="fillColor=#6C5CE0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="730" y="30" width="20" height="76" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;Camada de publicação &amp;#8212; o contrato entre os planos&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;gold (pub_*) &amp;#8594; publisher &amp;#8594; serving.* &amp;#8594; API&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;fontColor=#FFFFFF;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x